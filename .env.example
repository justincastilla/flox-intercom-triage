# Copy to .env and fill in. .env is gitignored — never commit real values.

# From Developer Hub -> your app -> Authentication
INTERCOM_ACCESS_TOKEN=
# From Developer Hub -> your app -> Basic information (used to verify webhooks)
INTERCOM_CLIENT_SECRET=

ANTHROPIC_API_KEY=

# Colon-separated local checkouts to search with ripgrep.
DOC_ROOTS=/Users/justin/Code/flox-docs:/Users/justin/Code/flox

# Shadow mode: compute briefs, log them, post nothing. Flip to true when ready.
POST_NOTES=false
MIN_CONFIDENCE=0.55
# Also honour the agent's own judgement that a note would add nothing.
REQUIRE_WORTH_POSTING=true

# Local testing only — lets unsigned requests through when no client secret is set.
ALLOW_UNSIGNED_WEBHOOKS=false
